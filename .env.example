# ==========================================
# Ví dụ biến môi trường cấu hình MUSE2API
# Sao chép thành .env là có hiệu lực: cp .env.example .env
# ==========================================

# [Bắt buộc/Tuỳ chọn] Khoá xác thực cho trang quản trị và API (bắt đầu bằng m2a_).
# Nếu để trống, lần khởi động đầu tiên chương trình sẽ tự sinh một khoá ngẫu nhiên mạnh và in ra log console.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# Địa chỉ và cổng dịch vụ lắng nghe (trong container Docker cần đặt 0.0.0.0)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Địa chỉ truy cập công khai bên ngoài (cho client hạ nguồn kết nối và trang quản trị ghép link, vd. https://api.yourdomain.com)
# Để trống thì trang quản trị tự dùng host và cổng mà trình duyệt đang truy cập
MUSE2API_PUBLIC_BASE=

# Đường dẫn file thực thi trình duyệt Chromium
# Linux/Docker thường là /usr/bin/chromium hoặc /usr/bin/chromium-browser
# Chạy cục bộ trên Windows có thể đặt đường dẫn đầy đủ tới Chrome hoặc để trống để tự tìm
MUSE2API_CHROMIUM=/usr/bin/chromium

# Cổng giao tiếp gỡ lỗi từ xa CDP
MUSE2API_CDP_PORT=19210

# Thời gian chờ tối đa của tác vụ (đơn vị: giây)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Số tác vụ tạo chạy đồng thời tối đa (có thể tăng tuỳ tài nguyên máy chủ, mặc định 2)
MUSE2API_CONCURRENCY=2

# Có tự động giữ phiên cho các tài khoản đã bị tắt trong trang quản trị không (0=tắt, 1=bật)
# Khi bật, tài khoản đã tắt vẫn được giữ phiên ngầm và gia hạn session, nhưng không được dùng để tạo ảnh/video hay chat
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0
